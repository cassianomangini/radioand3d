# Ative r2 somente depois de conferir o inventário completo e as URLs públicas de reprodução.
RADIO_CATALOG_SOURCE=
R2_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=musicas
R2_PUBLIC_BASE_URL=https://<PUBLIC_BUCKET_DOMAIN>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# O visualizer:sync reutiliza R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY se essas credenciais puderem escrever. Use as variaveis abaixo apenas se quiser uma chave de escrita separada, idealmente restrita a _analysis/v1/*.
R2_VISUALIZER_WRITE_ACCESS_KEY_ID=
R2_VISUALIZER_WRITE_SECRET_ACCESS_KEY=

# Pasta local com os mesmos arquivos de audio publicados no R2. Usada somente pelo lote offline do visualizador.
RADIO_LOCAL_AUDIO_DIR=
