# Ative r2 somente depois de conferir o inventário completo e as URLs públicas de reprodução.
RADIO_CATALOG_SOURCE=
R2_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_BUCKET=musicas
R2_PUBLIC_BASE_URL=https://<PUBLIC_BUCKET_DOMAIN>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# O visualizer:sync reutiliza R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY se essas credenciais puderem escrever. Use as variaveis abaixo apenas se quiser uma chave de escrita separada, idealmente restrita a _analysis/v3/*.
R2_VISUALIZER_WRITE_ACCESS_KEY_ID=
R2_VISUALIZER_WRITE_SECRET_ACCESS_KEY=

# Pasta local com os mesmos arquivos de audio publicados no R2. Usada somente pelo lote offline do visualizador.
RADIO_LOCAL_AUDIO_DIR=

# Backend CM 3D & Radio (PROJETO REMOTO CRIADO; SEM MIGRATIONS/BUCKET/SECRETS).
# Configuracao somente de servidor; NUNCA prefixar chaves/segredos com NEXT_PUBLIC_.
# Nao preencher com secrets do sistema Artesopolis Admin.
CM_SUPABASE_URL=
CM_SUPABASE_SECRET_KEY=
CM_QUOTE_BUCKET=quote-intake
CM_QUOTE_RATE_LIMIT_SECRET=
CM_QUOTE_SESSION_SECRET=
# Teto global em bytes para anexos reservados + armazenados; recomendado inicialmente 600 MB no Free.
CM_QUOTE_STORAGE_BUDGET_BYTES=600000000

# Vercel Cron: usa GET /api/internal/quote-retention + Authorization: Bearer <CRON_SECRET>.
# Configurar em producao SOMENTE quando a rota existir e estiver testada.
CRON_SECRET=

# Ponte server-to-server de Produtos, ENTREGA INDEPENDENTE do backend de Orçamento.
ARTESOPOLIS_CATALOG_URL=
ARTESOPOLIS_CATALOG_TOKEN=
