# Nomes apenas. Preencher em .env.local. Não commitar segredos.
# A rádio lê RADIO_CATALOG_SOURCE e R2_PUBLIC_BASE_URL.

RADIO_CATALOG_SOURCE=
R2_S3_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Orçamento. Ativar somente após configurar o projeto Supabase CM e testar o envio completo.
CM_QUOTE_INTAKE_ENABLED=false
CM_SUPABASE_URL=
CM_SUPABASE_SECRET_KEY=
CM_QUOTE_RATE_LIMIT_SECRET=
CM_QUOTE_SESSION_SECRET=
# Gmail: senha de aplicativo de 16 caracteres da conta casman1986@gmail.com.
CM_QUOTE_GMAIL_APP_PASSWORD=
# Alternativa futura com domínio de remetente verificado.
RESEND_API_KEY=
CM_QUOTE_EMAIL_FROM=
CRON_SECRET=

# Catálogo CMangini3D. Fonte operacional privada do Artesópolis Admin (PR #545),
# sem títulos/descrições SEO vindos do Admin.
# Apenas variáveis de servidor, nunca usar NEXT_PUBLIC_*.
CM_SITE_CATALOG_API_URL=
CM_SITE_CATALOG_TOKEN=
# Após validar o sincronismo, permitir indexação automática SOMENTE de
# novos itens comuns que passem pelos gates de qualidade do próprio site.
CM_SITE_AUTO_INDEX_ENABLED=false
